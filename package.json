{
  "name": "dsh-audit-skills",
  "version": "2.6.2",
  "description": "DeepSeek Harness plugin that refines plugin-page descriptions into clear Chinese (package name preserved), summarizes plugin status, and flags conflicts. Delegates updates/recommendations/guardianship to existing ecosystem plugins.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "config.yaml",
    "platforms",
    "references",
    "scripts",
    "docs",
    "locale",
    "agents",
    "requirements.txt",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "VERSION"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gtbwpkwjnb-alt/dsh-audit-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtbwpkwjnb-alt/dsh-audit-skills.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "audit",
    "skill-manager",
    "localization",
    "plugin-i18n"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.2 <4"
  },
  "scripts": {
    "check": "node scripts/preflight-client.mjs && node scripts/crash-rehearsal.mjs && node scripts/regression.mjs",
    "preflight": "node scripts/preflight-client.mjs",
    "rehearsal": "node scripts/crash-rehearsal.mjs",
    "regression": "node scripts/regression.mjs"
  }
}
